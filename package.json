{
  "name": "floci-ui",
  "version": "0.1.2",
  "private": true,
  "description": "Rust desktop UI for inspecting a local Floci AWS-compatible emulator.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/godkingjay/floci-ui.git"
  },
  "bugs": {
    "url": "https://github.com/godkingjay/floci-ui/issues"
  },
  "homepage": "https://github.com/godkingjay/floci-ui#readme",
  "type": "module",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "tailwind:build": "tailwindcss -i ./tailwind.css -o ./styles.css --minify",
    "tailwind:watch": "tailwindcss -i ./tailwind.css -o ./styles.css --watch",
    "trunk:build": "trunk build --release",
    "trunk:serve": "trunk serve",
    "dev:check-port": "node ./scripts/free-dev-port.mjs 1420",
    "build": "npm run tailwind:build && npm run trunk:build",
    "dev": "npm run dev:check-port && concurrently -k -n tailwind,trunk \"npm:tailwind:watch\" \"npm:trunk:serve\""
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.1",
    "concurrently": "^10.0.3",
    "tailwindcss": "^4.3.0"
  }
}
